generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// Singleton row (id = "default") holding site-wide configuration.
model Setting {
  id         String   @id @default("default")
  schoolName  String   @default("โรงเรียนตัวอย่าง")
  logoBase64  String? // data URL of the school logo
  periods     String? // JSON: [{ "period":1, "start":"08:30", "end":"09:20" }, ...]
  currentYear Int      @default(2569) // active academic year (พ.ศ.)
  currentTerm Int      @default(1) // active term/semester (1 or 2)
  lateGraceMinutes Int @default(5) // minutes after period start still counted on-time
  faceThreshold Float @default(0.45) // max face-match distance; lower = stricter
  termStart   String? // current term start date "YYYY-MM-DD"
  termEnd     String? // current term end date "YYYY-MM-DD"
  holidays    String? // JSON: [{ "date":"YYYY-MM-DD", "name":"..." }]
  updatedAt   DateTime @updatedAt
}

model User {
  id        String   @id @default(cuid())
  name      String
  username  String?  @unique
  email     String?  @unique
  password  String
  role      String   @default("teacher") // admin, teacher, kiosk
  createdAt DateTime @default(now())
  teacher   Teacher?
}

model Teacher {
  id          String       @id @default(cuid())
  userId      String       @unique
  user        User         @relation(fields: [userId], references: [id])
  photoBase64 String?
  faceData    String?      // JSON embeddings สำหรับ face-api.js
  subject     String?
  phone       String?
  createdAt   DateTime     @default(now())
  schedules   Schedule[]
  leaves      Leave[]
  attendances Attendance[]
}

model Schedule {
  id          String       @id @default(cuid())
  teacherId   String
  teacher     Teacher      @relation(fields: [teacherId], references: [id])
  year        Int          @default(2569) // academic year (พ.ศ.)
  term        Int          @default(1) // term/semester (1 or 2)
  dayOfWeek   Int          // 1-5 จันทร์-ศุกร์
  period      Int          // คาบที่
  room        String
  subject     String
  createdAt   DateTime     @default(now())
  attendances Attendance[]
  substitutions Substitution[]
}

model Leave {
  id            String    @id @default(cuid())
  teacherId     String
  teacher       Teacher   @relation(fields: [teacherId], references: [id])
  date          DateTime
  reason        String
  type          String    // sick, personal, other
  status        String    @default("pending") // pending, approved, rejected
  substituteId  String?   // deprecated: superseded by per-period Substitution[]
  createdAt     DateTime  @default(now())
  substitutions Substitution[]
}

// One row per (leave, schedule/period) — who covers that specific period.
model Substitution {
  id           String   @id @default(cuid())
  leaveId      String
  leave        Leave    @relation(fields: [leaveId], references: [id])
  scheduleId   String
  schedule     Schedule @relation(fields: [scheduleId], references: [id])
  substituteId String // Teacher id covering this period
  createdAt    DateTime @default(now())
}

model Attendance {
  id          String    @id @default(cuid())
  teacherId   String
  teacher     Teacher   @relation(fields: [teacherId], references: [id])
  scheduleId  String?
  schedule    Schedule? @relation(fields: [scheduleId], references: [id])
  room        String? // room where the check-in happened (for per-room status)
  checkIn     DateTime?
  checkOut    DateTime?
  status      String? // check-in punctuality: "on_time" | "late" (null = not tied to a period)
  lateMinutes Int? // minutes after period start at check-in
  earlyMinutes Int? // minutes before period end at check-out
  method      String    @default("face") // face, manual
  createdAt   DateTime  @default(now())
}